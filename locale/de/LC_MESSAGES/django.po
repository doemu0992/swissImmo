#: core/templates/core/dok_merkblatt_lueften.html:4
msgid "Merkblatt: Richtig Lüften und Pflegen"
msgstr "Merkblatt: Richtig Lüften und Pflegen"

#: core/templates/core/dok_merkblatt_lueften.html:5
msgid "Hinweise zur Vermeidung von Feuchtigkeits- und Schimmelschäden"
msgstr "Hinweise zur Vermeidung von Feuchtigkeits- und Schimmelschäden"

#: core/templates/core/dok_merkblatt_lueften.html:7
msgid ""
"Jeder Haushalt gibt täglich mehrere Liter Feuchtigkeit an die Raumluft ab "
"(Kochen, Duschen, Wäschetrocknen, Atmung, Pflanzen). Wird diese Feuchtigkeit "
"nicht regelmässig abgeführt, entsteht Schimmel. Mit dem richtigen Lüften und "
"Heizen beugen Sie Schäden vor."
msgstr ""
"Jeder Haushalt gibt täglich mehrere Liter Feuchtigkeit an die Raumluft ab "
"(Kochen, Duschen, Wäschetrocknen, Atmung, Pflanzen). Wird diese Feuchtigkeit "
"nicht regelmässig abgeführt, entsteht Schimmel. Mit dem richtigen Lüften und "
"Heizen beugen Sie Schäden vor."

#: core/templates/core/dok_merkblatt_lueften.html:9
msgid "Richtig Lüften"
msgstr "Richtig Lüften"

#: core/templates/core/dok_merkblatt_lueften.html:11
msgid ""
"<b>Stosslüften statt Kippen:</b> Fenster mehrmals täglich für 5–10 Minuten "
"ganz öffnen (Durchzug), statt sie dauerhaft gekippt zu lassen."
msgstr ""
"<b>Stosslüften statt Kippen:</b> Fenster mehrmals täglich für 5–10 Minuten "
"ganz öffnen (Durchzug), statt sie dauerhaft gekippt zu lassen."

#: core/templates/core/dok_merkblatt_lueften.html:12
msgid ""
"<b>Querlüften:</b> Gegenüberliegende Fenster gleichzeitig öffnen — so wird "
"die Luft am schnellsten ausgetauscht."
msgstr ""
"<b>Querlüften:</b> Gegenüberliegende Fenster gleichzeitig öffnen — so wird "
"die Luft am schnellsten ausgetauscht."

#: core/templates/core/dok_merkblatt_lueften.html:13
msgid ""
"<b>Nach Feuchtigkeit lüften:</b> Nach dem Duschen, Baden und Kochen sofort "
"lüften. Türen zu feuchten Räumen geschlossen halten."
msgstr ""
"<b>Nach Feuchtigkeit lüften:</b> Nach dem Duschen, Baden und Kochen sofort "
"lüften. Türen zu feuchten Räumen geschlossen halten."

#: core/templates/core/dok_merkblatt_lueften.html:14
msgid "<b>Schlafzimmer:</b> Morgens nach dem Aufstehen gründlich lüften."
msgstr "<b>Schlafzimmer:</b> Morgens nach dem Aufstehen gründlich lüften."

#: core/templates/core/dok_merkblatt_lueften.html:17
msgid "Richtig Heizen"
msgstr "Richtig Heizen"

#: core/templates/core/dok_merkblatt_lueften.html:19
msgid ""
"Alle Räume auf mindestens 17–18 °C temperieren, auch selten genutzte Zimmer."
msgstr ""
"Alle Räume auf mindestens 17–18 °C temperieren, auch selten genutzte Zimmer."

#: core/templates/core/dok_merkblatt_lueften.html:20
msgid "Heizkörper nicht mit Möbeln oder Vorhängen verdecken."
msgstr "Heizkörper nicht mit Möbeln oder Vorhängen verdecken."

#: core/templates/core/dok_merkblatt_lueften.html:21
msgid "Während des Lüftens die Thermostatventile herunterdrehen."
msgstr "Während des Lüftens die Thermostatventile herunterdrehen."

#: core/templates/core/dok_merkblatt_lueften.html:24
msgid "Feuchtigkeit vermeiden"
msgstr "Feuchtigkeit vermeiden"

#: core/templates/core/dok_merkblatt_lueften.html:26
msgid "Wäsche möglichst nicht in der Wohnung trocknen; falls doch, gut lüften."
msgstr ""
