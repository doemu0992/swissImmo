msgid "Import in Banana"
msgstr "Import in Banana"

msgid "Format «Banana Buchhaltung» wählen und die Datei (.txt) herunterladen."
msgstr ""
"Format «Banana Buchhaltung» wählen und die Datei (.txt) herunterladen."

msgid ""
"In Banana die Buchhaltung öffnen und «Aktionen > In Buchhaltung importieren "
"> Text file with column headers» wählen (auf Deutsch: Aktionen > In "
"Buchhaltung importieren)."
msgstr ""
"In Banana die Buchhaltung öffnen und «Aktionen > In Buchhaltung importieren "
"> Text file with column headers» wählen (auf Deutsch: Aktionen > In "
"Buchhaltung importieren)."

msgid ""
"Die Datei wählen. Die Kopfzeile (Date, Doc, Description, AccountDebit, "
"AccountCredit, Amount, VatCode, ExternalReference) erkennt Banana von "
"selbst."
msgstr ""
"Die Datei wählen. Die Kopfzeile (Date, Doc, Description, AccountDebit, "
"AccountCredit, Amount, VatCode, ExternalReference) erkennt Banana von "
"selbst."

msgid ""
"Die Kontonummern in der Datei kommen aus der Kontenzuordnung unten: Tragen "
"Sie dort die Kontonummern Ihres Banana-Kontenplans ein, sonst gehen die "
"Nummern von immoswiss in die Datei. Die ExternalReference (immoswiss-Jahr-"
"Buchungs-ID) ist je Buchung eindeutig. Datum yyyy-mm-dd, Tabulator als "
"Trennzeichen, Betrag mit Punkt: Das setzt das Format selbst."
msgstr ""
"Die Kontonummern in der Datei kommen aus der Kontenzuordnung unten: Tragen "
"Sie dort die Kontonummern Ihres Banana-Kontenplans ein, sonst gehen die "
"Nummern von immoswiss in die Datei. Die ExternalReference (immoswiss-Jahr-"
"Buchungs-ID) ist je Buchung eindeutig. Datum yyyy-mm-dd, Tabulator als "
"Trennzeichen, Betrag mit Punkt: Das setzt das Format selbst."

#, python-format
msgid "%(n)s Auszahlung wartet auf Freigabe"
