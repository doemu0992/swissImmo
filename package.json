{
  "name": "swissimmo-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright-E2E-Tests und der Tailwind-Bau für die swissImmo-Weboberfläche.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "css": "tailwindcss -c tailwind.config.js -i tailwind.eingang.css -o static/css/tailwind.css --minify",
    "css:aussen": "tailwindcss -c tailwind.aussen.config.js -i tailwind.eingang.css -o static/css/tailwind-aussen.css --minify",
    "css:alle": "npm run css && npm run css:aussen"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "tailwindcss": "3.4.19"
  }
}
