# Vorlage für die .env auf dem Server (echte .env NICHT committen)

# --- Sicherheit ---
# Zufälligen Key erzeugen: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# Produktion: False. Nur lokal zum Entwickeln auf True.
DEBUG=False
# Optional: HTTPS-Redirect/HSTS abschalten, falls nötig
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# Zusätzliche Domains (kommagetrennt)
# EXTRA_ALLOWED_HOSTS=meine-domain.ch,www.meine-domain.ch
# EXTRA_CSRF_ORIGINS=https://meine-domain.ch

# --- Datenbank ---
# Standard = SQLite (nichts setzen). Für PostgreSQL (empfohlen für Produktion):
# Treiber ist in requirements.txt enthalten (psycopg[binary]) — nichts nachzuinstallieren.
# DB_ENGINE=postgres
# DB_NAME=swissimmo
# DB_USER=swissimmo
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- E-Mail (Hoststar SMTP) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Portal / Links in E-Mails ---
PORTAL_BASE_URL=https://swissimmo.pythonanywhere.com

# --- E-Mail-Eingang (IMAP) ---
# Die Zugangsdaten selbst stehen NICHT mehr hier, sondern je Verwaltung in der
# Datenbank (Einstellungen → Postfächer). Grund: Jede Verwaltung hat ihr
# eigenes Postfach bei ihrem eigenen Anbieter — eine Umgebungsvariable kann nur
# eines davon tragen.
#
# Hier steht nur noch der Schlüssel, mit dem sie verschlüsselt abgelegt werden.
# Erzeugen mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WICHTIG: Eine Kopie ausserhalb des Servers aufbewahren. Ist der Schlüssel
# weg, sind die gespeicherten Zugangsdaten unlesbar und müssen für jede
# Verwaltung neu eingegeben werden. Ein Wechsel des Schlüssels hat dieselbe
# Folge — es gibt bewusst keine Hintertür.
#
# Wurde er erst NACH dem Ausrollen gesetzt, hat die Migration die Übernahme der
# alten Zugangsdaten übersprungen. Nachholen mit:
#   python manage.py postfaecher_uebernehmen
IMAP_SCHLUESSEL=

# Alt (bis 18.08.2026, wandern per Migration in die Datenbank; erst löschen,
# wenn der Verbindungstest in der Oberfläche grün ist):
# RECHNUNGS_IMAP_USER=
# RECHNUNGS_IMAP_PASSWORD=
# RECHNUNGS_IMAP_HOST=
# EMAIL_REPLY_USER=
# EMAIL_REPLY_PASSWORD=

# --- Externe Dienste (optional) ---
GROQ_API_KEY=
DOCUSEAL_API_KEY=
DOCUSEAL_WEBHOOK_SECRET=
